{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["cluster", "hubEndpoint", "tenants", "tlsSecret", "ledger", "operatorImage", "agentImage", "rollout", "heartbeatSeconds", "reconnectMinSeconds", "reconnectMaxSeconds"],
  "properties": {
    "cluster": {"enum": ["hugofleet-a", "hugofleet-b", "hugofleet-m5-e2e-a", "hugofleet-m5-e2e-b"]},
    "hubEndpoint": {"type": "string", "pattern": "^(10\\.([0-9]{1,3}\\.){2}[0-9]{1,3}|172\\.(1[6-9]|2[0-9]|3[01])\\.[0-9]{1,3}\\.[0-9]{1,3}|192\\.168\\.[0-9]{1,3}\\.[0-9]{1,3}):18443$"},
    "tenants": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "string", "maxLength": 60, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}},
    "tlsSecret": {"enum": ["hugofleet-agent-tls"]},
    "ledger": {"enum": ["hugofleet-agent-ledger"]},
    "operatorImage": {"enum": ["hugofleet-operator:m1"]},
    "agentImage": {"enum": ["hugofleet-agent:m5"]},
    "heartbeatSeconds": {"type": "integer", "minimum": 1, "maximum": 30},
    "reconnectMinSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "reconnectMaxSeconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "rollout": {"type": "integer", "minimum": 1, "maximum": 1000}
  }
}
